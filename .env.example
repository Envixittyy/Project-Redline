# Supabase (Phases 1C–1D).
#
# Server-only. Task and calendar-event tables have row level security enabled
# with no policies, so all access goes through the service role. Never
# expose the service role key to the browser and never prefix it with
# NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. IANA time zone used to decide what "today" and "tomorrow" mean for
# task views and Calendar. Defaults to the server's own time zone, which is UTC
# on most hosts, so set this when deploying.
# APP_TIME_ZONE=America/New_York

# Browser-exposed placeholders for a later authenticated phase. Unused today.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
