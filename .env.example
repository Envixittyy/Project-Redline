# Supabase Auth and normal owner-scoped application access.
# These values are designed to be public; RLS is the data security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Server-only VAPID contact URI, for example mailto:you@example.com.
VAPID_SUBJECT=

# Server-only bearer secret for the production notification scheduler. A long,
# random CRON_SECRET is sufficient; NOTIFICATION_DISPATCH_SECRET is an optional
# equivalent alias. Never prefix either value with NEXT_PUBLIC_.
CRON_SECRET=
# NOTIFICATION_DISPATCH_SECRET=

# Canonical application origin used to construct exact OAuth callback URLs.
# HTTPS is required outside localhost. Do not include a path or trailing slash.
APP_ORIGIN=http://localhost:3000

# Google Cloud OAuth 2.0 web application credentials. The client secret is
# server-only: never prefix it with NEXT_PUBLIC_ or commit a populated value.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Privileged maintenance only. Normal application reads and writes do not use
# these values. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase S1 verified Postmark inbound endpoint (server-only). See docs/SCHOOL_EMAIL_INGESTION.md.
# The existing privileged client is used only after webhook verification; UI reads use RLS.
POSTMARK_WEBHOOK_USERNAME=
# Generate a random password of at least 32 characters; never commit it.
POSTMARK_WEBHOOK_PASSWORD=
SCHOOL_EMAIL_OWNER_ID=
SCHOOL_EMAIL_RECIPIENT=
# Comma-separated exact addresses and Blackboard hostnames, no wildcards.
SCHOOL_BLACKBOARD_SENDERS=
SCHOOL_EMAIL_FORWARDERS=
SCHOOL_BLACKBOARD_HOSTS=

# One-time owner backfill input. Resolve this from Supabase Auth; never commit a
# populated value.
OWNER_USER_ID=

# Optional. IANA time zone used to decide what "today" and "tomorrow" mean for
# task views and Calendar. Defaults to the server's own time zone, which is UTC
# on most hosts, so set this when deploying.
# APP_TIME_ZONE=America/New_York

# Optional live RLS integration test project. Use an isolated local/test project.
SUPABASE_RLS_TEST_URL=
SUPABASE_RLS_TEST_PUBLISHABLE_KEY=
SUPABASE_RLS_TEST_SERVICE_ROLE_KEY=

# Optional AI trust boundary. Server-only, 64 hexadecimal characters (32 random
# bytes). Install the matching bytes in ai_private.signing_key using a database
# administrator connection; see docs/LOCAL_COMPANION_ARCHITECTURE.md. Missing or
# mismatched keys fail closed. Never use NEXT_PUBLIC_ or a service-role key here.
AI_TRUST_SIGNING_KEY=

# Optional Phase 10B cloud providers, server-only. Both model and key are required.
# Use a specific model supported by your account. No arbitrary endpoint overrides.
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional remote Companion. Only the exact HTTPS Tailscale Serve origin is public.
# Set this SAME origin at Next.js build time AND in the home-PC runner environment.
NEXT_PUBLIC_COMPANION_REMOTE_ORIGIN=
# Separate 32-byte random hex key, shared ONLY by Next.js server and home-PC daemon.
# Do NOT reuse AI_TRUST_SIGNING_KEY and never prefix this key with NEXT_PUBLIC_.
COMPANION_REQUEST_SIGNING_KEY=

# Companion-only OS environment (the standalone runner does not load this file).
# COMPANION_APP_ORIGIN=https://your-exact-forward-host.example
# COMPANION_OLLAMA_ENDPOINT=http://127.0.0.1:11434
# COMPANION_LLAMACPP_ENDPOINT=http://127.0.0.1:8080
# COMPANION_OPENAI_ENDPOINT=http://127.0.0.1:1234/v1
# Local port is fixed at 41400. Optional remote backend is 127.0.0.1:41401.
# COMPANION_TAILSCALE_USER=your-exact-tailscale-login
# Remote mode also needs NEXT_PUBLIC_COMPANION_REMOTE_ORIGIN and the separate
# COMPANION_REQUEST_SIGNING_KEY in the runner's environment. See
# docs/REMOTE_HYBRID_AI.md. Pairing codes are random each startup, TTY output only.
